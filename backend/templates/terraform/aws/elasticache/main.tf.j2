resource "aws_elasticache_cluster" "{{ resource.slug }}" {
  cluster_id      = "{{ aws_name(resource.props.get('name', resource.slug), 40) }}"
  engine          = "{{ resource.props.get('engine', 'redis') }}"
  node_type       = "{{ resource.props.get('nodeType', 'cache.t3.micro') }}"
  num_cache_nodes = {{ resource.props.get('numCacheNodes', 1) | hcl_int(1) }}
{% if resource.subnet_ref is defined and resource.subnet_ref %}
  subnet_group_name = aws_elasticache_subnet_group.{{ resource.slug }}_subnet_group.name
{% endif %}

  tags = {
    Name      = "{{ resource.props.get('name', resource.slug) }}"
    ManagedBy = "CloudForge"
  }
}

{% if resource.subnet_ref is defined and resource.subnet_ref %}
resource "aws_elasticache_subnet_group" "{{ resource.slug }}_subnet_group" {
  name       = "{{ resource.slug }}-subnet-group"
  subnet_ids = [{% for subnet_ref in resource.get('subnet_group_refs', [resource.subnet_ref]) %}aws_subnet.{{ subnet_ref }}.id{% if not loop.last %}, {% endif %}{% endfor %}]

  tags = {
    Name      = "{{ resource.slug }}-subnet-group"
    ManagedBy = "CloudForge"
  }
}
{% endif %}
