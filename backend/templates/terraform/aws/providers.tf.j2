terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
  required_version = ">= 1.5.0"
}

provider "aws" {
  region = var.aws_region

  # Credentials are loaded from environment variables or AWS config:
  # AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN
  # Never hardcode credentials in Terraform files.
}

{% if needs_ami_lookup %}
# Look up the latest Amazon Linux 2023 AMI dynamically so the generated HCL
# works in any region without a hardcoded AMI id. This is emitted only when at
# least one EC2 does not supply its own amiId — accounts that deny
# ec2:DescribeImages (e.g. via a Service Control Policy) should set a custom
# AMI on every EC2 so this data source is not needed.
data "aws_ami" "amazon_linux" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-*-x86_64"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}
{% endif %}
