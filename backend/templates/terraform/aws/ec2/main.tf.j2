resource "aws_instance" "{{ resource.slug }}" {
  ami           = var.ec2_ami_{{ resource.slug }}
  instance_type = var.ec2_instance_type_{{ resource.slug }}
{% if resource.subnet_ref is defined and resource.subnet_ref %}
  subnet_id     = aws_subnet.{{ resource.subnet_ref }}.id
{% else %}
  # subnet_id = "" # Connect this EC2 to a Subnet in the visual builder
{% endif %}
{% if resource.sg_refs is defined and resource.sg_refs %}
  vpc_security_group_ids = [{% for sg in resource.sg_refs %}aws_security_group.{{ sg }}.id{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}

  # Associate a public IP if in a public subnet
  associate_public_ip_address = {{ 'true' if resource.props.get('associatePublicIp', True) else 'false' }}

  tags = {
    Name      = "{{ resource.props.get('name', resource.slug) }}"
    ManagedBy = "CloudForge"
  }
}
