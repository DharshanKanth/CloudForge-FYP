# CloudForge Environment Variables
# Copy this to .env and fill in values

# Backend
DATABASE_URL=postgresql+asyncpg://cloudforge:cloudforge@localhost:5432/cloudforge
SECRET_KEY=cloudforge-secret-key-change-in-production

# Frontend
VITE_API_URL=http://localhost:8000

# AWS credentials for Terraform plan/apply/destroy (used by the backend container).
# Copy this file to .env and fill in your real values. NEVER commit .env.
# Region must match the design's region (builder selector); defaults to us-east-1.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
